<Window x:Class="SuspensionSimulation.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Suspension Simulation — Load Lab" Width="1220" Height="760" MinWidth="1000" MinHeight="650" Background="#16191D" Foreground="#E9EDF1">
  <Window.Resources>
    <Style TargetType="{x:Type TextBox}"><Setter Property="Background" Value="#101317"/><Setter Property="Foreground" Value="#F3F6F8"/><Setter Property="BorderBrush" Value="#52606D"/><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="0,2,0,2"/></Style>
    <Style TargetType="{x:Type CheckBox}"><Setter Property="Foreground" Value="#E9EDF1"/><Setter Property="Margin" Value="0,3,0,3"/></Style>
    <Style TargetType="{x:Type DataGrid}"><Setter Property="Background" Value="#101317"/><Setter Property="Foreground" Value="#E9EDF1"/><Setter Property="RowBackground" Value="#1A1F25"/><Setter Property="AlternatingRowBackground" Value="#20262E"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  </Window.Resources>
  <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="284"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0"><StackPanel>
      <TextBlock Text="LOAD LAB" FontSize="24" FontWeight="Bold"/><TextBlock Text="Rigid quasi-static setup comparison" Foreground="#BFC8D1" Margin="0,4,0,16"/>
      <TextBlock Text="SETUP INPUTS" FontWeight="Bold" Foreground="#9ED4FF"/>
      <Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Front spring (N/mm)"/><TextBox x:Name="FrontSpring" Grid.Column="1" Text="80" LostFocus="SetupChanged"/>
        <TextBlock Grid.Row="1" Text="Rear spring (N/mm)"/><TextBox x:Name="RearSpring" Grid.Row="1" Grid.Column="1" Text="90" LostFocus="SetupChanged"/>
        <TextBlock Grid.Row="2" Text="CG height (m)"/><TextBox x:Name="CgHeight" Grid.Row="2" Grid.Column="1" Text="0.48" LostFocus="SetupChanged"/>
        <TextBlock Grid.Row="3" Text="Wheelbase (m)"/><TextBox x:Name="Wheelbase" Grid.Row="3" Grid.Column="1" Text="2.484" LostFocus="SetupChanged"/>
        <TextBlock Grid.Row="4" Text="Front track (m)"/><TextBox x:Name="FrontTrack" Grid.Row="4" Grid.Column="1" Text="1.539" LostFocus="SetupChanged"/>
        <TextBlock Grid.Row="5" Text="Rear track (m)"/><TextBox x:Name="RearTrack" Grid.Row="5" Grid.Column="1" Text="1.533" LostFocus="SetupChanged"/>
        <TextBlock Grid.Row="6" Text="G axis sweep cap"/><TextBox x:Name="SweepCap" Grid.Row="6" Grid.Column="1" Text="2.0" LostFocus="GCapChanged"/>
        <TextBlock Grid.Row="7" Text="Total G cap"/><TextBox x:Name="TotalGCap" Grid.Row="7" Grid.Column="1" Text="2.0" LostFocus="GCapChanged"/>
        <TextBlock Grid.Row="8" Text="Bump-stop gap (stop mm)"/><TextBox x:Name="BumpStopGap" Grid.Row="8" Grid.Column="1" Text="25.0" LostFocus="SetupChanged"/>
      </Grid>
      <TextBlock Text="ARB MODEL" FontWeight="Bold" Foreground="#9ED4FF" Margin="0,4,0,0"/>
      <TextBlock x:Name="ArbModeBadge" Text="TUBULAR GEOMETRY (PRIMARY)" Foreground="#8FE3A8" FontWeight="Bold" Margin="0,2,0,4"/>
      <Expander Header="Front tubular ARB" IsExpanded="True"><Grid Margin="0,3,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Outside diameter (mm)"/><TextBox x:Name="FrontArbOd" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="1" Text="Inside diameter (mm)"/><TextBox x:Name="FrontArbId" Grid.Row="1" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="2" Text="Shear modulus (GPa)"/><TextBox x:Name="FrontArbG" Grid.Row="2" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="3" Text="Torsion length (m)"/><TextBox x:Name="FrontArbLength" Grid.Row="3" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="4" Text="Lever arm (mm)"/><TextBox x:Name="FrontArbArm" Grid.Row="4" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="5" Text="End-link length (mm)"/><TextBox x:Name="FrontArbLink" Grid.Row="5" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="6" Text="End-link angle (deg)"/><TextBox x:Name="FrontArbAngle" Grid.Row="6" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="7" Text="Wheel-to-link MR"/><TextBox x:Name="FrontArbMr" Grid.Row="7" Grid.Column="1" LostFocus="SetupChanged"/>
      </Grid></Expander>
      <Expander Header="Rear tubular ARB"><Grid Margin="0,3,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Outside diameter (mm)"/><TextBox x:Name="RearArbOd" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="1" Text="Inside diameter (mm)"/><TextBox x:Name="RearArbId" Grid.Row="1" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="2" Text="Shear modulus (GPa)"/><TextBox x:Name="RearArbG" Grid.Row="2" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="3" Text="Torsion length (m)"/><TextBox x:Name="RearArbLength" Grid.Row="3" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="4" Text="Lever arm (mm)"/><TextBox x:Name="RearArbArm" Grid.Row="4" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="5" Text="End-link length (mm)"/><TextBox x:Name="RearArbLink" Grid.Row="5" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="6" Text="End-link angle (deg)"/><TextBox x:Name="RearArbAngle" Grid.Row="6" Grid.Column="1" LostFocus="SetupChanged"/><TextBlock Grid.Row="7" Text="Wheel-to-link MR"/><TextBox x:Name="RearArbMr" Grid.Row="7" Grid.Column="1" LostFocus="SetupChanged"/>
      </Grid></Expander>
      <CheckBox x:Name="UseLegacyDirectArb" Content="Enable legacy direct-rate import mode" Checked="LegacyArbModeChanged" Unchecked="LegacyArbModeChanged"/>
      <StackPanel x:Name="LegacyDirectArbPanel" Visibility="Collapsed" Margin="0,2,0,8"><TextBlock Text="LEGACY DIRECT RATE — TEST/IMPORT ONLY" Foreground="#FFD27A" FontWeight="Bold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Front direct pair rate (N/mm)"/><TextBox x:Name="FrontLegacyArb" Grid.Column="1" Text="0" LostFocus="SetupChanged"/><TextBlock Grid.Row="1" Text="Rear direct pair rate (N/mm)"/><TextBox x:Name="RearLegacyArb" Grid.Row="1" Grid.Column="1" Text="0" LostFocus="SetupChanged"/></Grid></StackPanel>
      <TextBlock Text="VISIBLE METRICS" FontWeight="Bold" Foreground="#9ED4FF"/>
      <CheckBox x:Name="Lltd" Content="Front LLTD" IsChecked="True" Checked="MetricChanged" Unchecked="MetricChanged"/>
      <CheckBox x:Name="Rsd" Content="Front RSD" IsChecked="True" Checked="MetricChanged" Unchecked="MetricChanged"/>
      <CheckBox x:Name="Rcb" Content="RCB (RSD − mass fraction)" IsChecked="True" Checked="MetricChanged" Unchecked="MetricChanged"/>
      <CheckBox x:Name="Loads" Content="Four tire normal loads" IsChecked="True" Checked="MetricChanged" Unchecked="MetricChanged"/>
      <CheckBox x:Name="AxleSummary" Content="Front/rear and left/right totals" IsChecked="True" Checked="MetricChanged" Unchecked="MetricChanged"/>
      <CheckBox x:Name="Attitude" Content="Roll, pitch and delta ride heights" IsChecked="True" Checked="MetricChanged" Unchecked="MetricChanged"/>
      <CheckBox x:Name="Stiffness" Content="Corner wheel stiffness and ARB coupling" IsChecked="True" Checked="MetricChanged" Unchecked="MetricChanged"/>
      <TextBlock Text="Ride-height values are wheel-center delta from the uncalibrated static reference; negative means jounce/lower. They are not chassis datum-to-ground heights until the kinematics phase. Synthetic bump stops have zero rate; the gap is retained only as a future travel input. Assumptions: flat road, rigid chassis, ideal components. No tire grip, aero, kinematics, damping or transient effects." TextWrapping="Wrap" Foreground="#FFE0AF" Margin="0,18,0,0"/>
    </StackPanel></ScrollViewer>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="300"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#20252B" Margin="0,0,10,10" Padding="10" CornerRadius="7"><Grid><TextBlock Text="OVERHEAD / NORMAL-LOAD PREVIEW" FontWeight="Bold" Foreground="#9ED4FF"/><Canvas x:Name="CarCanvas" Margin="0,28,0,0" Background="#101317"/></Grid></Border>
      <Border Grid.Column="1" Background="#20252B" Margin="10,0,0,10" Padding="10" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="G-CIRCLE" FontWeight="Bold" Foreground="#9ED4FF"/><Button Content="Center" Click="CenterGClick" HorizontalAlignment="Right" Padding="10,3" DockPanel.Dock="Right"/></DockPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,6"><TextBlock x:Name="LongitudinalReadout" Foreground="#F3F6F8"/><TextBlock Text="  •  " Foreground="#8B99A7"/><TextBlock x:Name="LateralReadout" Foreground="#F3F6F8"/><TextBlock Text="  •  " Foreground="#8B99A7"/><TextBlock x:Name="MagnitudeReadout" Foreground="#F3F6F8"/></StackPanel><Canvas Grid.Row="2" x:Name="GCircleCanvas" Background="#101317" MouseLeftButtonDown="GCirclePointer" MouseMove="GCirclePointer"/></Grid></Border>
      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#20252B" Padding="10" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="MetricsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Metric" Binding="{Binding Label}" Width="1.5*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="Validity" Binding="{Binding Validity}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#CBD3DB" Margin="0,8,0,0" TextWrapping="Wrap"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
