<Window x:Class="SuspensionSimulation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suspension Simulation — GR86 Head-to-Head"
        Width="1600" Height="900" MinWidth="1280" MinHeight="720"
        Background="#111419" Foreground="#EAF0F5">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#1B2027"/>
    <SolidColorBrush x:Key="Panel2" Color="#202731"/>
    <SolidColorBrush x:Key="Muted" Color="#AEB9C4"/>
    <SolidColorBrush x:Key="AccentA" Color="#42B8FF"/>
    <SolidColorBrush x:Key="AccentB" Color="#FFB14A"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0E1217"/><Setter Property="Foreground" Value="#F5F8FA"/>
      <Setter Property="BorderBrush" Value="#536171"/><Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="5,2,0,2"/><Setter Property="MinWidth" Value="72"/>
    </Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#2A3440"/><Setter Property="Foreground" Value="#F5F8FA"/><Setter Property="BorderBrush" Value="#617184"/><Setter Property="Padding" Value="12,5"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#9ED4FF"/><Setter Property="Margin" Value="0,8,0,4"/></Style>
    <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#11161C"/><Setter Property="Foreground" Value="#EDF2F6"/><Setter Property="RowBackground" Value="#171D24"/><Setter Property="AlternatingRowBackground" Value="#1D242D"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#3E4A57"/></Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="GR86 HEAD-TO-HEAD" FontSize="27" FontWeight="Bold"/><TextBlock Text="One load state • two independently editable spring / tubular-bar setups" Foreground="{StaticResource Muted}"/></StackPanel>
      <Border Grid.Column="1" Background="#352B17" BorderBrush="#B68832" BorderThickness="1" CornerRadius="5" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="ValidityBadge" Text="3D GEOMETRY LIVE • PROVISIONAL EQUILIBRIUM" Foreground="#FFD37E" FontWeight="Bold"/></Border>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="SHARED G CONTROLLER" Style="{StaticResource Section}" Margin="0"/><Button Content="Center" Click="CenterGClick" DockPanel.Dock="Right"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,8,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Axis cap (G)"/><TextBlock Text="Combined cap (G)"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBox x:Name="SweepCap" Text="2.0" LostFocus="SharedInputChanged"/><TextBox x:Name="TotalGCap" Text="2.0" LostFocus="SharedInputChanged"/></StackPanel>
        </Grid>
        <Canvas Grid.Row="2" x:Name="GCircleCanvas" Background="#0D1116" MinHeight="250" MouseLeftButtonDown="GCirclePointer" MouseMove="GCirclePointer"/>
        <Grid Grid.Row="3" Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="LONGITUDINAL" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LongitudinalReadout" FontSize="18"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="LATERAL" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LateralReadout" FontSize="18"/></StackPanel>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,7,0,0"><TextBlock x:Name="MagnitudeReadout" FontWeight="SemiBold"/><TextBlock Text="Drag anywhere in the circle. One state is applied to both setups." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="13" Margin="0,0,6,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <DockPanel><TextBlock Text="SETUP A" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentA}"/><TextBlock Text="BASELINE" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
        <Grid Margin="0,8,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Front spring (N/mm)"/><TextBox x:Name="AFrontSpring" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="1" Text="Rear spring (N/mm)"/><TextBox x:Name="ARearSpring" Grid.Row="1" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="2" Text="Front bar OD (mm)"/><TextBox x:Name="AFrontOd" Grid.Row="2" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="3" Text="Front bar ID (mm)"/><TextBox x:Name="AFrontId" Grid.Row="3" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="4" Text="Rear bar OD (mm)"/><TextBox x:Name="ARearOd" Grid.Row="4" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="5" Text="Rear bar ID (mm)"/><TextBox x:Name="ARearId" Grid.Row="5" Grid.Column="1" LostFocus="SetupChanged"/>
        </Grid>
        <Grid Margin="0,7,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FRONT RSD" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ARsd" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentA}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="RCB" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ARcb" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentA}"/></StackPanel></Grid>
        <Canvas x:Name="ACarCanvas" Height="230" Background="#0D1116"/>
        <TextBlock x:Name="AStateSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel></ScrollViewer>
    </Border>

    <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="13" Margin="6,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <DockPanel><TextBlock Text="SETUP B" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentB}"/><TextBlock Text="VARIANT" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
        <Grid Margin="0,8,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Front spring (N/mm)"/><TextBox x:Name="BFrontSpring" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="1" Text="Rear spring (N/mm)"/><TextBox x:Name="BRearSpring" Grid.Row="1" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="2" Text="Front bar OD (mm)"/><TextBox x:Name="BFrontOd" Grid.Row="2" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="3" Text="Front bar ID (mm)"/><TextBox x:Name="BFrontId" Grid.Row="3" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="4" Text="Rear bar OD (mm)"/><TextBox x:Name="BRearOd" Grid.Row="4" Grid.Column="1" LostFocus="SetupChanged"/>
          <TextBlock Grid.Row="5" Text="Rear bar ID (mm)"/><TextBox x:Name="BRearId" Grid.Row="5" Grid.Column="1" LostFocus="SetupChanged"/>
        </Grid>
        <Grid Margin="0,7,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FRONT RSD" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BRsd" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentB}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="RCB" Foreground="{StaticResource Muted}"/><TextBlock x:Name="BRcb" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentB}"/></StackPanel></Grid>
        <Canvas x:Name="BCarCanvas" Height="230" Background="#0D1116"/>
        <TextBlock x:Name="BStateSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel></ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource Panel2}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,5"><TextBlock Text="DIRECT COMPARISON" FontWeight="Bold" Foreground="#9ED4FF"/><TextBlock x:Name="DeltaHeadline" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel>
        <DataGrid Grid.Row="1" x:Name="ComparisonGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
          <DataGrid.Columns><DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="2*"/><DataGridTextColumn Header="Setup A" Binding="{Binding A}" Width="*"/><DataGridTextColumn Header="Setup B" Binding="{Binding B}" Width="*"/><DataGridTextColumn Header="B − A" Binding="{Binding Delta}" Width="*"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*"/></DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#FFD58A" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </Grid>
    </Border>
  </Grid>
</Window>
